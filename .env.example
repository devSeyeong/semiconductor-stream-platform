# 파이프라인 접속 설정 (config.py 가 읽는다).
# 로컬 개발은 아래 값이 전부 기본값이라 .env 없이도 동작한다.
# EC2/컨테이너 배포 시 이 파일을 .env 로 복사해 값을 채운다.

# --- Kafka ---------------------------------------------------------------
# 호스트(venv)에서 실행: localhost:9092
# 컨테이너 안에서 실행: kafka:29092  (compose 의 INTERNAL 리스너)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=semiconductor-events

# --- PostgreSQL ----------------------------------------------------------
# 컨테이너 안에서 실행: PG_HOST=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=semiconductor
PG_USER=admin
PG_PASSWORD=admin

# --- Neo4j ---------------------------------------------------------------
# 컨테이너 안에서 실행: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=semiconductor
# 0 이면 Neo4j dual-write 를 끈다 (Neo4j 없이 파이프라인만 돌릴 때)
GRAPH_ENABLED=1

# --- Airflow (배치 오케스트레이션) ---------------------------------------
# `docker compose --profile airflow up -d` 로 띄운다.
# 대시보드의 "배치 오케스트레이션" 탭이 아래 자격증명으로 REST API 에 붙는다.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# 웹서버 세션 키 — 재시작해도 로그인이 유지되도록 고정값을 준다
AIRFLOW_SECRET_KEY=fdc-airflow-secret
# 브라우저가 여는 Airflow UI 주소. EC2 라면 http://<퍼블릭IP>:8080
AIRFLOW_UI_URL=http://localhost:8080
# 대시보드를 venv 로 돌릴 때는 API 도 호스트 기준이어야 한다
# (컨테이너로 돌리면 compose 가 http://airflow-webserver:8080/api/v1 을 주입)
AIRFLOW_API_URL=http://localhost:8080/api/v1

# --- LLM (graph/llm_rca.py) ---------------------------------------------
# 이미지에 굽지 말고 런타임에 주입할 것
ANTHROPIC_API_KEY=